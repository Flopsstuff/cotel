#!/usr/bin/env bash
#
# prepare-commit-msg — safety net for the agent co-author trailer.
#
# Part of the FlopBut agent-identity scheme (see docs/operations/agent-identity.md).
# The committing agent writes its own footer line, `Co-Authored-By: Name (Model)
# <email>`; the hook cannot know the model, so it never writes that line itself.
# It only acts when the message has NO Co-Authored-By trailer for
# $GIT_AUTHOR_EMAIL at all, and then appends a bare `Co-Authored-By: Name <email>`
# so the agent is still credited. Matching is by email, case-insensitive, so any
# `Name (Model) <email>` form counts as present.
#
# Idempotent: re-running never duplicates a trailer. Safe to install in every repo.

set -euo pipefail

COMMIT_MSG_FILE="$1"
COMMIT_SOURCE="${2:-}"

# Merge/squash messages are machine-generated and carry their own trailers.
case "$COMMIT_SOURCE" in
  merge|squash) exit 0 ;;
esac

NAME="${GIT_AUTHOR_NAME:-}"
EMAIL="${GIT_AUTHOR_EMAIL:-}"

# Git exports the configured identity to hooks even for humans, so only act on
# an agent identity.
[ -n "$NAME" ] || exit 0
case "$EMAIL" in
  *@agents.flopbut.*) ;;
  *) exit 0 ;;
esac

if awk -v want="$(printf '%s' "$EMAIL" | tr '[:upper:]' '[:lower:]')" '
  /^#/ { next }
  tolower($0) ~ /^co-authored-by:/ {
    line = tolower($0)
    if (match(line, /<[^>]*>/) && substr(line, RSTART + 1, RLENGTH - 2) == want) { found = 1 }
  }
  END { exit found ? 0 : 1 }
' "$COMMIT_MSG_FILE"; then
  exit 0
fi

git interpret-trailers --in-place --if-exists add \
  --trailer "Co-Authored-By: ${NAME} <${EMAIL}>" "$COMMIT_MSG_FILE"

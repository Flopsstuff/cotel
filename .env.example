CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
# Cloudflare Tunnel token (Zero Trust → Networks → tunnel install screen).
# When set, cotel container starts cloudflared in token mode automatically.
# Leave empty to skip the tunnel. See docs/operations/cloudflare-tunnel-remote.md.
CLOUDFLARE_TUNNEL_TOKEN=
# Public-facing OTLP ingest URL shown in the Setup page snippets.
# Set to the public URL operators should paste into their Claude Code settings,
# e.g. https://otlp.example.com. Leave empty for local dev (localhost:4318).
# If malformed, cotel logs a warning at startup and snippets fall back to localhost.
COTEL_PUBLIC_INGEST_URL=
PAPERCLIP_API_TOKEN=
PAPERCLIP_API_URL=
PAPERCLIP_COMPANY_ID=
